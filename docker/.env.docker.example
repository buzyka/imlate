# Example environment variables for Docker
# Copy this file to .env and modify as needed

ENVIRONMENT=development

# Enable iSAMS/ERP integration (default disabled)
ERP_INTEGRATION_ENABLED=false

# Database Configuration
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USERNAME=trackme
DATABASE_PASSWORD=trackme
DATABASE_NAME=tracker

# Application Port
APP_PORT=8080

# JWT auth secret (required, minimum 32 chars)
AUTH_TOKEN_SECRET=replace-with-at-least-32-characters

# MySQL Root Password (for Docker only)
MYSQL_ROOT_PASSWORD=rootpassword

# Development Dockerfile based on Debian 12
FROM golang:1.27-bookworm

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive

# Install development dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    make \
    gcc \
    g++ \
    libc6-dev \
    libsqlite3-dev \
    default-mysql-client \
    bash \
    curl \
    vim \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Go development tools (swag, migrate, golangci-lint, air). Their
# versions are pinned in tools/go.mod, which Dependabot keeps up to date.
COPY tools/go.mod tools/go.sum /tools/
RUN cd /tools && go install -tags 'mysql' tool

# Add Go binaries to PATH
ENV PATH="/go/bin:${PATH}"

WORKDIR /app

# Copy go mod files first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Expose port
EXPOSE 8080

# Default command for development (can be overridden)
CMD ["go", "run", "cmd/app/main.go"]
